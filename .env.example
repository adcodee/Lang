# Copy this file to .env.local and fill in real keys to switch off "Demo mode".
# With no keys set, the app runs fully with stubbed AI responses.

# Claude — powers the End-of-session debrief coach ONLY (why/when feedback,
# redo list), on both text and voice channels. Never the mid-chat partner.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for the debrief.
ANTHROPIC_MODEL=claude-opus-5

# Grok (xAI) — powers EVERY mid-chat tutor turn, text and voice alike (the
# speaking partner). Required for real (non-stub) replies on /practice at
# all, not just voice.
# Get a key at https://console.x.ai/
XAI_API_KEY=

# Optional: override the Grok model used for mid-chat turns. grok-4.6 is
# xAI's current flagship (docs.x.ai/developers/models) as of this writing —
# xAI retires model ids over time (grok-2-latest, this file's previous
# default, was retired 2026-05-15), so re-check that page if turns start
# silently stubbing again with a real key set.
XAI_MODEL=grok-4.6

# Speech-to-text for the "Say it" buttons on iOS (where the browser has no
# speech recognition). By DEFAULT this reuses XAI_API_KEY above via xAI's Grok
# Voice STT (https://api.x.ai/v1/stt) — nothing more to set.
#
# To use an OpenAI-compatible provider instead, set STT_API_KEY (takes
# precedence over the xAI key). With no STT key at all, the app falls back to
# typed-romaji speaking practice.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
