# Copy this file to .env.local and fill in real keys to switch off "Demo mode".
# With no keys set, the app runs fully with stubbed AI responses.

# Claude — powers the End-of-session debrief coach ONLY (why/when feedback,
# redo list), on both text and voice channels. Never the mid-chat partner.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for the debrief.
ANTHROPIC_MODEL=claude-opus-5

# Grok (xAI) — powers EVERY mid-chat tutor turn, text and voice alike (the
# speaking partner). Required for real (non-stub) replies on /practice at
# all, not just voice.
# Get a key at https://console.x.ai/
XAI_API_KEY=

# Optional: override the Grok model used for mid-chat turns.
# grok-4.3 is the current pick (2026-09-19): still a reasoning model, just
# the cheapest one benchmarked (~2.7x cheaper than the flagship grok-4.6),
# ~7.2s avg response time. grok-4.20-0309-non-reasoning was tried first —
# faster (~1.3-1.5s) and passed the benchmark script's fixed test turns,
# but failed in a real on-device conversation: asked "お名前は？", it
# returned a nonsensical "correction" (confused its own next line with the
# separate field the prompt asks for). Zero-deliberation models are the
# wrong tradeoff when an instruction requires keeping two distinct jobs
# straight — worth remembering before picking a non-reasoning model again
# just because a benchmark's fixed test cases passed. grok-4.6 was
# ~23s/call for this prompt — reasoning can't be disabled on it, only
# turned down. xAI retires model ids over time (grok-2-latest, an earlier
# default here, was retired 2026-05-15) — re-run scripts/bench-grok-models.ts
# periodically rather than assuming this pick stays valid forever, and
# don't trust a benchmark's fixed test turns alone — this bug only showed
# up in a real, organic conversation.
XAI_MODEL=grok-4.3

# Optional: reasoning_effort for the current (reasoning) model
# (low/medium/high/xhigh). Code default is "low" already; this only needs
# setting if you want a different level. If you override XAI_MODEL above
# to a non-reasoning model, this field is rejected and the code already
# detects that and retries without it automatically.
XAI_REASONING_EFFORT=low

# Speech-to-text for the "Say it" buttons on iOS (where the browser has no
# speech recognition). By DEFAULT this reuses XAI_API_KEY above via xAI's Grok
# Voice STT (https://api.x.ai/v1/stt) — nothing more to set.
#
# To use an OpenAI-compatible provider instead, set STT_API_KEY (takes
# precedence over the xAI key). With no STT key at all, the app falls back to
# typed-romaji speaking practice.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
