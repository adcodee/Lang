# Copy this file to .env.local and fill in real keys to switch off "Demo mode".
# With no keys set, the app runs fully with stubbed AI responses.

# Claude — powers the TEXT tutor (grammar correction + conversational feedback).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for text feedback.
ANTHROPIC_MODEL=claude-opus-4-8

# Grok (xAI) — powers the VOICE tutor (speaking/listening practice).
# Get a key at https://console.x.ai/
XAI_API_KEY=

# Optional: override the Grok model used for voice turns.
XAI_MODEL=grok-2-latest
